{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PackageDownloader Registry Schema",
  "description": "Schema definition for PackageDownloader remote mirror registry",
  "type": "object",
  "required": [
    "schema_version",
    "registry_version",
    "revision",
    "updated_at",
    "mirrors"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Structure compatibility version"
    },
    "registry_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version of registry contents"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonically increasing sequence number to protect against replay and rollback"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp of registry update"
    },
    "mirrors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "website",
          "enabled",
          "providers"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "Unique mirror identifier"
          },
          "name": {
            "type": "string",
            "description": "Display name of the mirror"
          },
          "description": {
            "type": "string",
            "description": "Description in Persian or English"
          },
          "website": {
            "type": "string",
            "format": "uri",
            "description": "Official website URL"
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether the mirror is globally enabled in registry"
          },
          "priority": {
            "type": "integer",
            "description": "Optional priority ranking hint (lower number = higher priority)"
          },
          "providers": {
            "type": "object",
            "properties": {
              "flutter": {
                "type": "object",
                "required": ["enabled", "storage_url"],
                "properties": {
                  "enabled": { "type": "boolean" },
                  "storage_url": { "type": "string", "format": "uri" },
                  "test_path": { "type": "string" }
                }
              },
              "dart": {
                "type": "object",
                "required": ["enabled", "hosted_url"],
                "properties": {
                  "enabled": { "type": "boolean" },
                  "hosted_url": { "type": "string", "format": "uri" },
                  "test_package": { "type": "string" }
                }
              },
              "gradle": {
                "type": "object",
                "required": ["enabled"],
                "properties": {
                  "enabled": { "type": "boolean" },
                  "maven_central_url": { "type": ["string", "null"] },
                  "google_maven_url": { "type": ["string", "null"] },
                  "gradle_plugins_url": { "type": ["string", "null"] },
                  "distribution_url": { "type": ["string", "null"] }
                }
              },
              "android": {
                "type": "object",
                "required": ["enabled"],
                "properties": {
                  "enabled": { "type": "boolean" },
                  "google_maven_url": { "type": ["string", "null"] }
                }
              },
              "ios": {
                "type": "object",
                "required": ["enabled"],
                "properties": {
                  "enabled": { "type": "boolean" },
                  "notes": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}
